{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-sync-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-overwatch-db",
      "database_id": "18ae658e-4c06-4391-aff2-a8ae99d41b1e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VAULT_BUCKET",
      "bucket_name": "nexus-personal-vault"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // Set to "true" once the updated extension (sending HMAC + X-TopFlop-Token) is live
    "STRICT_TOPFLOP_AUTH": "false"
    // Secrets (SERVER_PEPPER, LEGACY_SERVER_PEPPER, EXTENSION_SECRET, MASTER_ADMIN_SECRET)
    // must be set via `npx wrangler secret put <NAME>` (or in local `.dev.vars`, never committed).
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
